<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/AppTopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mission_title" />

        <TextView
            android:id="@+id/tvStatusPill"
            style="@style/StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_active"
            android:text="@string/status_online" />

    </LinearLayout>


    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">


            <!-- MISSION INFORMATION -->
            <LinearLayout
                style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMissionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        tools:text="Mission Title" />

                    <TextView
                        android:id="@+id/tvPriorityPill"
                        style="@style/StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:background="@drawable/pill_urgent" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAssignedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />


                <!-- MAP -->
                <FrameLayout
                    android:id="@+id/mapPreview"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_map_preview">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </FrameLayout>

                <TextView
                    android:id="@+id/btnMapNavigate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/mission_navigate_button"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- OFFLINE NOTICE -->
            <LinearLayout
                android:id="@+id/groupOfflineNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/pending" />

                <LinearLayout
                    style="@style/CardSurface"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shift_saved_on_phone"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSavedDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/missions_error_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </LinearLayout>


            <!-- MISSION STATE PAGES -->
            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">


                <!-- ASSIGNED MISSION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/CardSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/step1"
                            layout="@layout/item_step_row" />

                        <include
                            android:id="@+id/step2"
                            layout="@layout/item_step_row" />

                        <include
                            android:id="@+id/step3"
                            layout="@layout/item_step_row" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAcknowledge"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/mission_acknowledge_button" />

                    <Button
                        android:id="@+id/btnNavigate"
                        style="@style/Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/mission_navigate_button" />

                </LinearLayout>


                <!-- MISSION IN PROGRESS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/CardSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <!-- ACKNOWLEDGED REMOVED -->

                        <TextView
                            android:id="@+id/tvStartedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />


                        <!-- PHOTO PREVIEW SLOTS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/photoSlot1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_photo_slot" />

                            <FrameLayout
                                android:id="@+id/photoSlot2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_photo_slot" />

                            <FrameLayout
                                android:id="@+id/photoSlot3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_photo_slot" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPhotoProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>


                    <!-- ADD PHOTO -->
                    <Button
                        android:id="@+id/btnTakePhoto"
                        style="@style/Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="Add photo" />


                    <!-- COMPLETE MISSION -->
                    <Button
                        android:id="@+id/btnCompleteMission"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginBottom="80dp"
                        android:text="@string/mission_complete_button" />

                </LinearLayout>

            </ViewFlipper>

        </LinearLayout>

    </ScrollView>


    <!-- PANIC BUTTON: ALWAYS BOTTOM RIGHT -->
    <ImageButton
        android:id="@+id/btnPanicCircle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_panic_circle"
        android:contentDescription="Panic"
        android:scaleType="centerInside"
        android:src="@drawable/ic_bell"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>