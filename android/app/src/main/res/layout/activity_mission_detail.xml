<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        style="@style/AppTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/AppTopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mission_title" />

        <TextView
            android:id="@+id/tvStatusPill"
            style="@style/StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_active"
            android:text="@string/status_online" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- Mission summary card, shared by both states -->
            <LinearLayout style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMissionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_title"
                        tools:text="Illegal parking blocking access" />

                    <TextView
                        android:id="@+id/tvPriorityPill"
                        style="@style/StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:background="@drawable/pill_urgent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAssignedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <FrameLayout
                    android:id="@+id/mapPreview"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_map_preview">

                    <TextView
                        android:id="@+id/tvMapDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/brand"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_caption" />
                </FrameLayout>
            </LinearLayout>

            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <!-- 0: ASSIGNED — steps 1-3, Acknowledge + Navigate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/CardSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_step_row" android:id="@+id/step1" />
                        <include layout="@layout/item_step_row" android:id="@+id/step2" />
                        <include layout="@layout/item_step_row" android:id="@+id/step3" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAcknowledge"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/mission_acknowledge_button" />

                    <Button
                        android:id="@+id/btnNavigate"
                        style="@style/Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/mission_navigate_button" />
                </LinearLayout>

                <!-- 1: IN PROGRESS — checklist + photos + complete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/CardSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/circle_step_done"
                                android:padding="4dp"
                                android:src="@drawable/ic_check" />
                            <TextView
                                android:id="@+id/tvAcknowledgedAt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/circle_step_done"
                                android:padding="4dp"
                                android:src="@drawable/ic_check" />
                            <TextView
                                android:id="@+id/tvStartedAt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/circle_step_current" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/mission_step_complete"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/photoRow"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/photoSlot1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/space_s"
                                android:background="@drawable/bg_photo_slot" />

                            <FrameLayout
                                android:id="@+id/photoSlot2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/space_s"
                                android:background="@drawable/bg_photo_slot" />

                            <FrameLayout
                                android:id="@+id/photoSlot3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_photo_slot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPhotoProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTakePhoto"
                        style="@style/Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/mission_take_photo" />

                    <Button
                        android:id="@+id/btnCompleteMission"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/mission_complete_button" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
