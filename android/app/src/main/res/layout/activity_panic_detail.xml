<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- TOP BAR: the same navy bar as every other logged-in screen. -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/AppTopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/panic_detail_title" />

    </LinearLayout>

    <!--
        Everything above the map. It scrolls rather than clips when large
        accessibility text makes it taller than its share, and the guideline
        caps that share so the map always keeps at least the bottom third.
        Ordered by urgency: who, how to reach them, how fresh the position is.
        The scrollbar stays visible (it only draws when there is more to
        scroll), so an officer can see that something is below the fold.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/headerScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:scrollbars="vertical"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/mapMinimumGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- WHO: the one red element on the screen, so it reads as an
                 emergency at a glance without tinting the map. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/urgent_alert"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_m">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_on_brand"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        tools:text="Officer Name" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/panic_detail_needs_help"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_on_brand"
                        android:textSize="@dimen/text_title" />
                </LinearLayout>

            </LinearLayout>

            <!-- HOW TO REACH THEM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:id="@+id/tvUserPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    tools:text="Phone: +961 3 123 456" />

                <!-- The main action. Full width and tall for a thumb in a
                     hurry; grows with the text instead of clipping it.
                     Hidden in code when there is no number. -->
                <Button
                    android:id="@+id/btnCallOfficer"
                    style="@style/Button.Success"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:minHeight="@dimen/action_button_min_height"
                    android:text="@string/panic_detail_call"
                    android:textSize="@dimen/text_action"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_s"
                    app:iconSize="28dp"
                    app:iconTint="@color/text_on_brand"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- HOW FRESH THE POSITION IS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    tools:text="Last location recorded at 14:02:11" />

                <!-- Connection trouble: the app's amber warning, as on the
                     missions screen's offline notice. Red stays reserved for
                     the emergency itself. -->
                <TextView
                    android:id="@+id/tvLocationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_status_warning"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Cannot reach the server. Retrying. The location shown may be out of date."
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mapMinimumGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.66" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerScroll" />

</androidx.constraintlayout.widget.ConstraintLayout>
