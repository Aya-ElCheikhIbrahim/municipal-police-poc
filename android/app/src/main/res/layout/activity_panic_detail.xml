<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- TOP BAR: the same navy bar as every other logged-in screen. -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/AppTopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/panic_detail_title" />

    </LinearLayout>

    <!--
        HOW FRESH THE POSITION IS: a thin strip under the bar. The name and the
        call action have moved onto the map itself (the pin's red name bubble
        and the floating Call button), so only the freshness line, and the
        amber connection warning, stay here.
    -->
    <LinearLayout
        android:id="@+id/headerStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            tools:text="Last location recorded at 14:02:11" />

        <!-- Connection trouble: the app's amber warning, as on the missions
             screen's offline notice. Red stays reserved for the emergency. -->
        <TextView
            android:id="@+id/tvLocationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_status_warning"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Cannot reach the server. Retrying. The location shown may be out of date."
            tools:visibility="visible" />

    </LinearLayout>

    <!-- The map fills everything below the strip. -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerStrip" />

    <!-- The main action, floating over the map. A pill, so it blends with the
         app's rounded buttons rather than reading as a sharp box; it shows the
         officer's number and dials it. Hidden in code when there is no number
         on file. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnCallOfficer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_l"
        android:contentDescription="@string/panic_detail_call"
        android:text="@string/panic_detail_call"
        android:textColor="@color/text_on_brand"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/active_ok"
        app:icon="@drawable/ic_phone"
        app:iconTint="@color/text_on_brand"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="+961 3 123 456"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
