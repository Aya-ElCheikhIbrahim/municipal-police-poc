<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ========================================================= -->
        <!-- SHARED TOP BAR                                            -->
        <!-- ========================================================= -->

        <LinearLayout
            style="@style/AppTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTopBarTitle"
                style="@style/AppTopBar.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/tvStatusPill"
                style="@style/StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:background="@drawable/pill_offline"
                android:text="@string/status_no_signal" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/tap_target_min"
                android:layout_height="@dimen/tap_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- MAIN PAGES                                                -->
        <!-- ========================================================= -->

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/space_l">


            <!-- ===================================================== -->
            <!-- PAGE 0: OFF DUTY                                      -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    style="@style/CardSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_m"
                        android:text="@string/shift_off_duty_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <Button
                        android:id="@+id/btnStartShift"
                        style="@style/Button.Success"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/shift_start_button"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center"
                        android:text="@string/shift_off_duty_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>


            <!-- ===================================================== -->
            <!-- PAGE 1: REMOVED (WAS ON DUTY)                         -->
            <!-- ===================================================== -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />


            <!-- ===================================================== -->
            <!-- PAGE 2: SYNCING                                      -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ProgressBar
                        android:id="@+id/progressSyncing"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/shift_uploading_title"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:id="@+id/tvSyncingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center"
                        android:text="24 locations and 2 photos are being sent to dispatch."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </ViewFlipper>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPanicCircle"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_panic_circle"
        android:src="@drawable/ic_warning"
        android:scaleType="fitCenter"
        android:padding="16dp"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
