<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <!-- Shared top bar: officer name / screen title + status pill + settings gear -->
    <LinearLayout
        style="@style/AppTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTopBarTitle"
            style="@style/AppTopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/tvStatusPill"
            style="@style/StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:background="@drawable/pill_offline"
            android:text="@string/status_no_signal" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/tap_target_min"
            android:layout_height="@dimen/tap_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_l">

        <!-- ============ 0: OFF DUTY ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:text="@string/shift_off_duty_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/btnStartShift"
                    style="@style/Button.Success"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/shift_start_button"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:text="@string/shift_off_duty_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <!-- ============ 1: ON DUTY ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvShiftTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/shift_elapsed_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvLocationLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:text="Rue Tell, Tripoli · accurate to 8 m"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMissions"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:backgroundTint="@color/accent"
                android:text="@string/shift_missions_button" />

            <!-- Working-offline extras (hidden on-duty when connected) -->
            <LinearLayout
                android:id="@+id/groupOfflineNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLastSynced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shift_last_synced"
                    android:textColor="@color/pending"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <LinearLayout style="@style/CardSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shift_saved_on_phone"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvSavedDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/shift_saved_detail"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Primary actions live in the lower half for one-thumb reach -->
            <Button
                android:id="@+id/btnPanic"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/ripple_panic_button"
                android:stateListAnimator="@animator/animator_panic_button"
                android:text="@string/shift_panic_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button" />

            <Button
                android:id="@+id/btnEndShift"
                style="@style/Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shift_end_button" />
        </LinearLayout>

        <!-- ============ 2: SYNCING ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/shift_uploading_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/tvSyncingDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/shift_uploading_detail"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
