<?xml version="1.0" encoding="utf-8"?>
<!-- The red name bubble above the panic pin. Rounded with the app's card
     radius so it blends with the rest of the UI rather than reading as a
     sharp box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/urgent_alert" />
    <corners android:radius="@dimen/corner_radius_card" />
</shape>
