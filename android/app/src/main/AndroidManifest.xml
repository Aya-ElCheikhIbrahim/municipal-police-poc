<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground location service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".OfficerApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfficerApp"
        android:usesCleartextTraffic="true">

        <!-- Login / Launcher -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.OfficerApp.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Shift -->
        <activity
            android:name=".ui.login.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.OfficerApp.NoActionBar" />

        <activity
            android:name=".ui.shift.ShiftActivity"
            android:exported="false"
            android:theme="@style/Theme.OfficerApp.NoActionBar" />

        <!-- Mission List -->
        <activity
            android:name=".ui.missions.MissionListActivity"
            android:exported="false"
            android:theme="@style/Theme.OfficerApp.NoActionBar" />

        <!-- Mission Detail -->
        <activity
            android:name=".ui.missiondetail.MissionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.OfficerApp.NoActionBar" />

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OfficerApp.NoActionBar" />

        <!-- Allows the camera to save a full-resolution photo -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".notifications.OfficerFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

    </application>

</manifest>